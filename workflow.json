    {
      "parameters": {
        "jsCode": "const productName = $json.product_name || \"غير محدد\";\nconst productPrice = $json.product_price != null ? $json.product_price : \"غير محدد\";\nconst productQuantity = $json.product_quantity != null ? $json.product_quantity : \"غير محدد\";\nconst productUrl = $json.product_url || \"#\";  // الرابط للزر، # كخيار افتراضي إذا لم يكن موجود\n\nconst messageText =\n`تم إضافة منتج جديد\n\nاسم المنتج: ${productName}\nالسعر: ${productPrice} ريال\nالكمية: ${productQuantity}`;\n\nreturn [\n  {\n    json: {\n      message_text: messageText,\n      product_url: productUrl  // تمرير الرابط مع نفس العنصر\n    }\n  }\n];\n"
      },
